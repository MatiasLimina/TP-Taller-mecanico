### 65. Alta con dos items: precios copiados, total y primera linea de historial (caso PDF C-10)
# Esperado: 201 exactamente {"id": 1, "estado": "PENDIENTE", "patente": "ZOR001", "total": "68000.00",
#   "creada_en": "<ISO con Z>", "mecanico_id": null, "falla": "Ruido al frenar", "cliente": "Laura Duena",
#   "items": [{"repuesto_id": 2, "codigo": "ORD-FRE-01", "descripcion": "Pastillas de freno delanteras",
#   "cantidad": 1, "precio_unitario": "32000.00", "subtotal": "32000.00"},
#   {"repuesto_id": 4, "codigo": "ORD-ACE-01", "descripcion": "Aceite 5W30 por litro", "cantidad": 3,
#   "precio_unitario": "12000.00", "subtotal": "36000.00"}],
#   "historial": [{"desde_estado": null, "hasta_estado": "PENDIENTE", "usuario_id": <recepcion>,
#   "cuando": "<igual a creada_en>"}]}
# psql: la orden, sus items y el historial; el stock no cambia:
#   SELECT estado, mecanico_id, total FROM orden_trabajo WHERE id = 1;  -- PENDIENTE | (NULL) | 68000.00
#   SELECT repuesto_id, cantidad, precio_unitario FROM item_orden WHERE orden_id = 1 ORDER BY id;
#     -- 2 | 1 | 32000.00 y 4 | 3 | 12000.00
#   SELECT desde_estado, hasta_estado, usuario_id = (SELECT id FROM usuario WHERE email = 'recepcion@ordenes.example.com')
#     FROM historial_estado_orden WHERE orden_id = 1;  -- (NULL) | PENDIENTE | t
#   SELECT id, stock FROM repuesto WHERE id IN (2, 4) ORDER BY id;  -- (2,4) (4,20)
#   SELECT count(*) FROM movimiento_stock;  -- 4
# @name altaOrden
# @no-cookie-jar
POST {{base}}/ordenes
Content-Type: application/json
Cookie: {{loginRecepcion.response.headers.Set-Cookie}}

{
  "vehiculo_id": {{vehDuena.response.body.$.id}},
  "falla": "  Ruido al frenar ",
  "items": [
    {"repuesto_id": 2, "cantidad": 1},
    {"repuesto_id": 4, "cantidad": 3}
  ]
}

