### 55. DELETE con orden PENDIENTE
# Esperado: 409 El vehículo tiene órdenes abiertas y no se puede dar de baja
# psql: antes: INSERT INTO orden_trabajo (vehiculo_id, estado, falla, total) SELECT id, 'PENDIENTE', 'Prueba C-10', 0 FROM vehiculo WHERE patente = 'ZC005AA' AND borrado_en IS NULL;
# psql: despues: borrado_en de ZC005AA sigue nulo
# @no-cookie-jar
DELETE {{base}}/vehiculos/{{vehJorge2.response.body.$.id}}
Cookie: {{loginRecepcion.response.headers.Set-Cookie}}

### 56. DELETE con orden EN_REPARACION
# Esperado: 409 el mismo mensaje
# psql: antes: UPDATE orden_trabajo SET estado = 'EN_REPARACION' WHERE vehiculo_id = (SELECT id FROM vehiculo WHERE patente = 'ZC005AA' AND borrado_en IS NULL);
# @no-cookie-jar
DELETE {{base}}/vehiculos/{{vehJorge2.response.body.$.id}}
Cookie: {{loginRecepcion.response.headers.Set-Cookie}}

### 57. DELETE con orden TERMINADA
# Esperado: 204 sin cuerpo
# psql: antes: UPDATE orden_trabajo SET estado = 'TERMINADA' WHERE vehiculo_id = (SELECT id FROM vehiculo WHERE patente = 'ZC005AA' AND borrado_en IS NULL);
# psql: despues: borrado_en no nulo y con zona; la orden sigue
# @no-cookie-jar
DELETE {{base}}/vehiculos/{{vehJorge2.response.body.$.id}}
Cookie: {{loginRecepcion.response.headers.Set-Cookie}}

### 58. Segunda baja del mismo vehiculo
# Esperado: 404 El vehículo no existe
# psql: borrado_en no cambio
# @no-cookie-jar
DELETE {{base}}/vehiculos/{{vehJorge2.response.body.$.id}}
Cookie: {{loginRecepcion.response.headers.Set-Cookie}}

### 59. DELETE con orden CANCELADA
# Esperado: 204
