# =============================================================================
# C. Acceso (spec parts-catalog, "Acceso al catalogo por rol")
# =============================================================================

### 13. POST /repuestos/{filtro}/reponer sin cookie y con cuerpo invalido
# La sesion se exige antes que el contrato del cuerpo.
# Esperado: 401 {"detail": "Se requiere iniciar sesión"} (NO 422)
# @no-cookie-jar
POST {{base}}/repuestos/{{altaFiltro.response.body.$.id}}/reponer
Content-Type: application/json

{
  "cantidad": 0,
  "stock": 1
}

### 14. POST /repuestos/{filtro}/reponer con la sesion de recepcion
# Esperado: 403 {"detail": "No tiene permiso para realizar esta operación"}
# psql: el stock del filtro no cambio y sigue 1 solo movimiento:
#   SELECT stock FROM repuesto WHERE codigo = 'STK-FIL-01';  -- 5
#   SELECT count(*) FROM movimiento_stock WHERE repuesto_id = (SELECT id FROM repuesto WHERE codigo = 'STK-FIL-01');  -- 1
# @no-cookie-jar
POST {{base}}/repuestos/{{altaFiltro.response.body.$.id}}/reponer
Content-Type: application/json
Cookie: {{loginRecepcion.response.headers.Set-Cookie}}

{
  "cantidad": 2
}

### 15. POST /repuestos/{filtro}/reponer con la sesion de mecanico
# Esperado: 403 {"detail": "No tiene permiso para realizar esta operación"}
# @no-cookie-jar
POST {{base}}/repuestos/{{altaFiltro.response.body.$.id}}/reponer
Content-Type: application/json
Cookie: {{loginMecanico.response.headers.Set-Cookie}}

{
  "cantidad": 2
}

