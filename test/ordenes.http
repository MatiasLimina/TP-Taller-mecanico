### 44. Repuesto repetido en los items (RN10, S-08)
# Esperado: 422 con loc ["body", "items"] y mensaje "Hay repuestos repetidos en la orden: 2"
# @no-cookie-jar
POST {{base}}/ordenes
Content-Type: application/json
Cookie: {{loginRecepcion.response.headers.Set-Cookie}}

{
  "vehiculo_id": {{vehDuena.response.body.$.id}},
  "falla": "Ruido al frenar",
