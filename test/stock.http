# =============================================================================
# D. Reposicion (spec stock-movements, "Reposicion de stock")
# =============================================================================

### 24. Reposicion de 7 unidades con motivo a recortar
# Esperado: 200 exactamente {"id": <n>, "codigo": "STK-FIL-01", "descripcion": "Filtro de aceite",
#   "precio": "8500.00", "stock": 12}
# psql: movimiento nuevo hecho por jefa, sin orden y con el motivo recortado:
#   SELECT cantidad, motivo, orden_id, usuario_id = (SELECT id FROM usuario WHERE email = 'jefa@stock.example.com')
#     FROM movimiento_stock WHERE repuesto_id = (SELECT id FROM repuesto WHERE codigo = 'STK-FIL-01') ORDER BY id DESC LIMIT 1;
#     -- 7 | Compra a proveedor | (NULL) | t
# @no-cookie-jar
POST {{base}}/repuestos/{{altaFiltro.response.body.$.id}}/reponer
Content-Type: application/json
Cookie: {{loginJefa.response.headers.Set-Cookie}}

{
  "cantidad": 7,
  "motivo": "  Compra a proveedor  "
}

