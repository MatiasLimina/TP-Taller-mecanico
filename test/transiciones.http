# M. Invariantes (psql, specs work-orders y stock-movements) -- no son peticiones HTTP
# =============================================================================

### 93. stock = suma de movimientos para todos los repuestos
# psql:
#   SELECT r.id, r.stock, COALESCE(SUM(m.cantidad), 0) FROM repuesto r LEFT JOIN movimiento_stock m ON m.repuesto_id = r.id GROUP BY r.id ORDER BY r.id;
# Esperado: stock 9, 4, 0, 15, 1, cada uno igual a la suma de sus movimientos.

### 94. cada orden TERMINADA tiene un movimiento por item, opuesto a la cantidad del item
# psql:
#   SELECT m.orden_id, m.repuesto_id, m.cantidad, i.cantidad, m.motivo FROM movimiento_stock m JOIN item_orden i ON i.orden_id = m.orden_id AND i.repuesto_id = m.repuesto_id ORDER BY 1, 2;
#   SELECT count(*) FROM movimiento_stock WHERE orden_id IS NOT NULL;
# Esperado: 5 filas (ordenes 1, 2, 6 y 7) con m.cantidad = -i.cantidad y motivo 'Orden #<id> terminada'; el conteo es 5.

### 95. historial de cada orden
# psql:
#   SELECT orden_id, string_agg(COALESCE(desde_estado, 'null') || '>' || hasta_estado, ',' ORDER BY id) FROM historial_estado_orden GROUP BY orden_id ORDER BY 1;
# Esperado: ordenes 1, 2, 6 y 7: null>PENDIENTE,PENDIENTE>EN_REPARACION,EN_REPARACION>TERMINADA; ordenes 3, 4 y 8:
# null>PENDIENTE,PENDIENTE>CANCELADA; orden 5: null>PENDIENTE,PENDIENTE>EN_REPARACION (20 lineas en total).

### 96. estado y mecanico de cada orden al final
# psql:
#   SELECT id, estado, mecanico_id, total FROM orden_trabajo ORDER BY id;
# Esperado: 1 TERMINADA <mecanico>, 2 TERMINADA <mecanico>, 3 CANCELADA (NULL), 4 CANCELADA (NULL), 5 EN_REPARACION
# <mecanico>, 6 TERMINADA <mecanico2>, 7 TERMINADA <mecanico2>, 8 CANCELADA (NULL); el total es el del alta.

### 97. el historial esta encadenado y termina en el estado de la orden
# psql:
#   SELECT orden_id, id FROM (SELECT orden_id, id, desde_estado, LAG(hasta_estado) OVER (PARTITION BY orden_id ORDER BY id) AS previo FROM historial_estado_orden) h WHERE desde_estado IS DISTINCT FROM previo;
#   SELECT count(*) FROM orden_trabajo o WHERE o.estado IS DISTINCT FROM (SELECT hasta_estado FROM historial_estado_orden h WHERE h.orden_id = o.id ORDER BY h.id DESC LIMIT 1);
# Esperado: 0 filas en el primero; 0 en el segundo (el ultimo hasta_estado de cada orden es su estado).

# =============================================================================
# Verificados por script (no expresables por HTTP; script temporal no versionado
# `verificar_c14.py`, design D9 bloques a-i)
# =============================================================================
# - (a) Dos transiciones sobre la misma orden: dos terminar detenidos por un FOR UPDATE de otra conexion -> uno 200 y
#   otro 409, stock descontado una vez, una linea de historial nueva y un solo aviso; iniciar + cancelar simultaneos
#   sobre una PENDIENTE -> exactamente un 200; terminar + cancelar sobre una EN_REPARACION -> 200 y 409.
# - (b) Terminar detenido despues del descuento (historial.add espera un evento): reponer, PATCH de precio, DELETE de otro
#   repuesto de la orden y un alta con esos repuestos esperan; al liberar, la orden confirma y despues responden 200/200/204/201.
# - (c) Repuesto bloqueado primero por otra conexion: terminar espera con la orden bloqueada y un cancelar de la misma
#   orden espera en el paso 1; COMMIT -> 200 y 409; variante con baja del repuesto confirmada antes -> terminar 200.
# - (d) Sin interbloqueos: 20 vueltas de dos terminar de ordenes distintas con los mismos dos repuestos (items en orden
#   inverso), un alta, un reponer y un PATCH de precio a la vez -> nunca 40P01 ni 500; stock = suma de movimientos.
# - (e) Atomicidad: el segundo de tres repuestos no alcanza -> 409 y foto antes/despues identica; OrdenesUoW cuyo
#   historial.add lanza RuntimeError despues del descuento -> el error llega sin reemplazo y no queda ningun cambio.
# - (f) Aviso: una sola llamada por terminar con 200, despues del cuerpo de la respuesta y viendo la orden TERMINADA y sus
#   movimientos confirmados; ninguna con 409 (stock y estado), 403, 404, ni en iniciar/cancelar; una linea INFO de
#   uvicorn.error.avisos >= 0,5 s despues de empezar la tarea.
# - (g) Consultas por operacion: iniciar 7, cancelar 8 (personal) / 9 (dueño), terminar 11 (1 item) / 15 (3 items) sentencias
#   en el bloque; la primera es el FOR UPDATE de orden_trabajo; ninguna FOR sobre vehiculo; UPDATE repuesto en orden
#   ascendente de id; ids como parametros.
# - (h) /openapi.json: las tres rutas sin requestBody, orden_id entero 1..2147483647, respuesta 200 con los campos de
#   OrdenDetalleSalida, sin password_hash, borrado_en ni stock.
# - (i) Invariantes sobre todas las filas: stock = suma de movimientos; cada orden TERMINADA tiene un movimiento por item
#   con cantidad = -item.cantidad y ninguna otra tiene; historial encadenado y terminado en el estado de la orden;
#   mecanico_id nulo en toda orden que nunca se inicio.
#
# Escenario -> caso: iniciar 50-56 y 37-44; solo se inicia pendiente 51, 52, 65, 88; sin datos del cliente 53; orden
# inexistente e id invalido 41-46; terminar con permiso 57-60, 73, 75-77; solo se termina en reparacion 61, 63, 89;
# descuento de stock 62, 68, 73, 77; falta de stock 66, 70, 71 y (e); PDF C-11/C-12 66-69; aviso 62, 68 y (f);
# cancelar 78-87, 92; catalogo 48-49; historial 50, 62, 80 y 95-97; respuesta 50, 62; concurrencia (a)-(d).
