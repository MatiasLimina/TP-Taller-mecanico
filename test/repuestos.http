POST {{base}}/repuestos
Content-Type: application/json
Cookie: {{loginJefa.response.headers.Set-Cookie}}

{
  "codigo": "R11-STOCK",
  "descripcion": "Con stock directo",
  "precio": 1000,
  "stock": 5
}

