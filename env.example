# Plantilla de configuracion. Copiar con:  Copy-Item env.example .env
# (no usar redireccion `>` de PowerShell: escribe UTF-16 y rompe la lectura)
# El archivo .env NO se versiona. Completar los dos secretos obligatorios.

# --- Base de datos ---
POSTGRES_USER=taller
# OBLIGATORIO. Contrasena del usuario de PostgreSQL (dejar vacio aqui, completar en .env)
POSTGRES_PASSWORD=
POSTGRES_DB=taller
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Seguridad ---
# OBLIGATORIO. Clave de firma del token, minimo 32 caracteres. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# Vigencia del token de acceso, en segundos
ACCESS_TOKEN_EXPIRE_SECONDS=1800
# Costo de bcrypt (4 a 31)
BCRYPT_COST=12
# Hashes bcrypt simultaneos permitidos
BCRYPT_MAX_CONCURRENCY=4
# Cookie con atributo Secure (true solo detras de HTTPS)
COOKIE_SECURE=false

# --- Pool de conexiones ---
POOL_SIZE=5
MAX_OVERFLOW=10

# --- Diagnostico ---
# Imprime el SQL ejecutado en consola (util en desarrollo)
SQL_ECHO=true
