### 48. cancelar con el estado CANCELADA fuera del catalogo
# Esperado: 409 {"detail": "El catálogo de estados no tiene el estado CANCELADA"}
# Antes (psql):
#   DELETE FROM estado_orden WHERE codigo = 'CANCELADA';
# psql: la orden 8 sigue PENDIENTE con su unica linea de historial:
#   SELECT estado FROM orden_trabajo WHERE id = 8;  -- PENDIENTE
#   SELECT count(*) FROM historial_estado_orden WHERE orden_id = 8;  -- 1
# Despues (psql):
#   restaurar el catalogo y marcar PENDIENTE como final para el caso 49:
#   INSERT INTO estado_orden (codigo, descripcion, posicion, es_final) VALUES
#     ('PENDIENTE', 'Pendiente', 1, false), ('EN_REPARACION', 'En reparación', 2, false),
#     ('TERMINADA', 'Terminada', 3, true), ('CANCELADA', 'Cancelada', 4, true)
#   ON CONFLICT DO NOTHING;
#   UPDATE estado_orden SET es_final = true WHERE codigo = 'PENDIENTE';
# @no-cookie-jar
POST {{base}}/ordenes/8/cancelar
Cookie: {{loginJefa.response.headers.Set-Cookie}}

### 49. iniciar con PENDIENTE marcado como final: el catalogo decide (409 de estado final)
# Esperado: 409 {"detail": "La orden 8 está PENDIENTE, un estado final: no admite más cambios"}
# psql: sin cambios (la orden 8 sigue PENDIENTE sin mecanico y con una linea):
#   SELECT estado, mecanico_id FROM orden_trabajo WHERE id = 8;  -- PENDIENTE | (NULL)
#   SELECT count(*) FROM historial_estado_orden WHERE orden_id = 8;  -- 1
# Despues (psql):
#   devolver PENDIENTE a no final:
#   UPDATE estado_orden SET es_final = false WHERE codigo = 'PENDIENTE';
# @no-cookie-jar
POST {{base}}/ordenes/8/iniciar
Cookie: {{loginMecanico.response.headers.Set-Cookie}}

