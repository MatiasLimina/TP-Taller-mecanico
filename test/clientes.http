### 6. Registro de pendiente@clientes.example.com
# Esperado: 201
# psql: Despues del 6, preparacion:
# psql:   INSERT INTO asignacion_rol (usuario_id, rol) SELECT id, 'RECEPCION' FROM usuario WHERE email = 'recepcion@clientes.example.com';
# psql:   INSERT INTO asignacion_rol (usuario_id, rol) SELECT id, 'ADMIN' FROM usuario WHERE email = 'admin@clientes.example.com';
# psql:   INSERT INTO asignacion_rol (usuario_id, rol) SELECT id, 'MECANICO' FROM usuario WHERE email = 'mecanico@clientes.example.com';
# psql:   DELETE FROM cliente WHERE usuario_id = (SELECT id FROM usuario WHERE email = 'mecanico@clientes.example.com');
# psql:   UPDATE usuario SET debe_cambiar_password = true WHERE email = 'pendiente@clientes.example.com';
# @no-cookie-jar
POST {{base}}/auth/registro
Content-Type: application/json

{
  "email": "pendiente@clientes.example.com",
  "password": "ClaveSegura1",
  "nombre": "Pedro Pendiente",
  "documento": "43000006",
  "telefono": "1143000006"
}

