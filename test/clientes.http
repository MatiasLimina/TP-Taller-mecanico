### 13. POST /clientes sin cookie
# Esperado: 401 {"detail": "Se requiere iniciar sesión"}
# psql: SELECT count(*) FROM cliente WHERE documento = '43000099' -- 0
# @no-cookie-jar
POST {{base}}/clientes
Content-Type: application/json

{
  "nombre": "Ines Intrusa",
  "documento": "43000099",
  "telefono": "1100000099"
}

### 14. POST /clientes con loginDuena (solo CLIENTE)
# Esperado: 403 {"detail": "No tiene permiso para realizar esta operación"}
# psql: SELECT count(*) FROM cliente WHERE documento = '43000099' -- 0
# @no-cookie-jar
POST {{base}}/clientes
Cookie: {{loginDuena.response.headers.Set-Cookie}}
Content-Type: application/json

{
  "nombre": "Ines Intrusa",
  "documento": "43000099",
  "telefono": "1100000099"
}

### 15. POST /clientes con loginMecanico
