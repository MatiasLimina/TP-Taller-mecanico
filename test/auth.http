# =============================================================================
# test/auth.http -- Casos de C-07 auth-registro-login (C-02, C-03, C-04, C-05)
#
# Cliente HTTP: extension REST Client de VS Code (o el cliente HTTP de JetBrains).
# Servidor: .venv\Scripts\python.exe -m uvicorn main:app --port 8000
# Las comprobaciones de filas se hacen con psql (consultas en cada seccion).
#
# ESTADO CONOCIDO ANTES DE CORRER EL ARCHIVO DE ARRIBA ABAJO
#   (migrado a la ultima revision; sin seed -- C-06 -- la base queda sin usuarios):
#
#   -- limpia SOLO las filas de este archivo (todos sus correos terminan en @example.com):
#   DELETE FROM evento_seguridad WHERE actor LIKE '%@example.com';
#   DELETE FROM intento_acceso WHERE email LIKE '%@example.com';
#   DELETE FROM asignacion_rol WHERE usuario_id IN
#     (SELECT id FROM usuario WHERE email LIKE '%@example.com');
#   DELETE FROM cliente WHERE documento = '20111222' OR usuario_id IN
#     (SELECT id FROM usuario WHERE email LIKE '%@example.com');
#   DELETE FROM usuario WHERE email LIKE '%@example.com';
#   -- ficha de cliente cargada por el taller, SIN usuario (caso "documento de cliente
#   -- sin usuario"; con el seed de C-06 se usa un documento del seed):
#   INSERT INTO cliente (nombre, documento, telefono)
#     VALUES ('Jorge Sin Usuario', '20111222', '1155550000');
#
# Con el seed (C-06): `python seed.py` y después SOLO el `INSERT` de Jorge Sin Usuario de abajo;
# NO correr los `DELETE` (el seed ya vació la base y `LIKE '%@example.com'` alcanzaría a los
# usuarios del seed, que tienen órdenes y movimientos).
#
# Los correos y documentos de este archivo son unicos: el archivo es de una sola
# pasada sobre ese estado. La contrasena valida de todos los usuarios es ClaveSegura1.
# (Una base de dev con un usuario ya registrado con esos correos o documentos da 409 donde
# se espera 201.)
# =============================================================================

@base = http://localhost:8000

# =============================================================================
# C-02 -- Registro
# =============================================================================

### 1. Registro exitoso (S-04: sin sesion, sin cookie)
# Esperado: 201 con {id, email, nombre, cliente:{id, nombre, documento, telefono}};
#   email "ana@example.com"; SIN password_hash, SIN password, SIN token y SIN Set-Cookie.
# psql:
#   SELECT id, email, nombre, activo, debe_cambiar_password, left(password_hash, 7)
#     FROM usuario WHERE email = 'ana@example.com';
#     -- activo=t, debe_cambiar_password=f, hash empieza con $2b$12$
#   SELECT rol, vence_en, revocada_en FROM asignacion_rol
#     WHERE usuario_id = (SELECT id FROM usuario WHERE email = 'ana@example.com');
#     -- una fila CLIENTE, vence_en y revocada_en nulos
#   SELECT c.nombre, c.documento, c.telefono, c.usuario_id = u.id AS vinculada
#     FROM cliente c JOIN usuario u ON u.email = 'ana@example.com' WHERE c.documento = '30123456';
#   SELECT actor, accion FROM evento_seguridad WHERE actor = 'ana@example.com';
#     -- ('ana@example.com', 'Auto-registro de cliente')
# @name registro_ok
# @no-cookie-jar
POST {{base}}/auth/registro
Content-Type: application/json

{
  "email": "ana@example.com",
  "password": "ClaveSegura1",
  "nombre": "Ana Perez",
  "documento": "30123456",
  "telefono": "1155551111"
}

### 2. Correo repetido (documento nuevo)
# Esperado: 409 {"detail": "El correo ya está registrado"} (sin texto de la base).
# psql: no hay filas nuevas -- SELECT count(*) FROM cliente WHERE documento = '50000001'; -- 0
# @no-cookie-jar
POST {{base}}/auth/registro
Content-Type: application/json

{
  "email": "ana@example.com",
  "password": "ClaveSegura1",
  "nombre": "Otra Ana",
  "documento": "50000001",
  "telefono": "1155552222"
}

### 3. Mismo correo con otras mayusculas y espacios (S-01: correo normalizado)
