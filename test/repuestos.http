### 59. PATCH solo de descripcion (no toca precio ni stock)
# Esperado: 200 con "descripcion": "Filtro de aceite sintético", "precio": "8500.00", "stock": 10
# psql: 0 lineas de historial del filtro.
# @no-cookie-jar
PATCH {{base}}/repuestos/{{altaFiltro.response.body.$.id}}
Content-Type: application/json
Cookie: {{loginJefa.response.headers.Set-Cookie}}

{
  "descripcion": "Filtro de aceite sintético"
}

### 60. PATCH de precio (RN20)
# Esperado: 200 con "precio": "9000.00" y "stock": 10
# psql: 1 linea de historial: 8500.00 -> 9000.00, usuario_id = id de jefa:
#   SELECT usuario_id = (SELECT id FROM usuario WHERE email = 'jefa@repuestos.example.com')
#     FROM historial_precio_repuesto WHERE repuesto_id = (SELECT id FROM repuesto WHERE codigo = 'FIL-ACE-01');  -- t
# @no-cookie-jar
PATCH {{base}}/repuestos/{{altaFiltro.response.body.$.id}}
Content-Type: application/json
Cookie: {{loginJefa.response.headers.Set-Cookie}}

{
  "precio": 9000
}

