### 7. Registro de pendiente@transiciones.example.com
# Esperado: 201
# Despues (psql):
#   jefa pasa a ser ADMIN, recepcion RECEPCION, mecanico y mecanico2 MECANICO, y pendiente debe
#   cambiar la contrasena:
#   INSERT INTO asignacion_rol (usuario_id, rol)
#     SELECT id, 'ADMIN' FROM usuario WHERE email = 'jefa@transiciones.example.com';
#   INSERT INTO asignacion_rol (usuario_id, rol)
#     SELECT id, 'RECEPCION' FROM usuario WHERE email = 'recepcion@transiciones.example.com';
#   INSERT INTO asignacion_rol (usuario_id, rol)
#     SELECT id, 'MECANICO' FROM usuario WHERE email = 'mecanico@transiciones.example.com';
#   INSERT INTO asignacion_rol (usuario_id, rol)
#     SELECT id, 'MECANICO' FROM usuario WHERE email = 'mecanico2@transiciones.example.com';
#   UPDATE usuario SET debe_cambiar_password = true WHERE email = 'pendiente@transiciones.example.com';
# @name registroPendiente
# @no-cookie-jar
POST {{base}}/auth/registro
Content-Type: application/json

{
  "email": "pendiente@transiciones.example.com",
  "password": "ClaveSegura1",
  "nombre": "Pablo Pendiente",
  "documento": "47000007",
  "telefono": "1147000007"
}

