#   SELECT nombre, telefono, usuario_id FROM cliente WHERE documento = '20111222';
#     -- ('Jorge Sin Usuario', '1155550000', NULL)
# psql: no quedo usuario suelto --
#   SELECT count(*) FROM usuario WHERE email = 'dario@example.com'; -- 0
# @no-cookie-jar
POST {{base}}/auth/registro
Content-Type: application/json

{
  "email": "dario@example.com",
  "password": "ClaveSegura1",
  "nombre": "Dario Ruiz",
  "documento": "20111222",
  "telefono": "1155554444"
}

