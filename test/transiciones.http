### 31. Alta de la orden 8: para el catalogo y la cancelacion del ADMIN
# Esperado: 201 con "id": 8, "estado": "PENDIENTE", "mecanico_id": null y "total": "8500.00"
# psql: las ocho ordenes quedaron PENDIENTES, sin mecanico y con su primera linea; el stock sigue en el inicial:
#   SELECT id, estado, mecanico_id, total FROM orden_trabajo ORDER BY id;
#     -- 8 filas: PENDIENTE | (NULL) | 56500.00, 18000.00, 8500.00, 8500.00, 189000.00, 2000.00, 12000.00, 8500.00
#   SELECT count(*), bool_and(desde_estado IS NULL AND hasta_estado = 'PENDIENTE') FROM historial_estado_orden;  -- 8 | t
#   SELECT id, stock FROM repuesto ORDER BY id;  -- (1,10) (2,4) (3,2) (4,20) (5,3)
#   SELECT count(*) FROM movimiento_stock WHERE motivo = 'Stock inicial';  -- 5
#   SELECT count(*) FROM movimiento_stock;  -- 5
# @no-cookie-jar
POST {{base}}/ordenes
Content-Type: application/json
Cookie: {{loginRecepcion.response.headers.Set-Cookie}}

{
  "vehiculo_id": {{vehDuena2.response.body.$.id}},
  "falla": "Diagnóstico",
  "items": [
    {"repuesto_id": 1, "cantidad": 1}
  ]
}

