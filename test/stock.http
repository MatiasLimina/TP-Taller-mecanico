### 47. DELETE /repuestos/{baja} (baja logica, C-11)
# Esperado: 204 sin cuerpo
# @no-cookie-jar
DELETE {{base}}/repuestos/{{altaBaja.response.body.$.id}}
Cookie: {{loginJefa.response.headers.Set-Cookie}}

### 48. POST /repuestos/{baja}/reponer: un repuesto dado de baja no se repone
# Esperado: 404 {"detail": "El repuesto no existe"}
# psql: el repuesto dado de baja conserva su stock y su unico movimiento:
#   SELECT stock FROM repuesto WHERE codigo = 'STK-BAJ-01';  -- 3
#   SELECT count(*) FROM movimiento_stock WHERE repuesto_id = (SELECT id FROM repuesto WHERE codigo = 'STK-BAJ-01');  -- 1
# @no-cookie-jar
POST {{base}}/repuestos/{{altaBaja.response.body.$.id}}/reponer
Content-Type: application/json
Cookie: {{loginJefa.response.headers.Set-Cookie}}

{
  "cantidad": 2
}

# =============================================================================
# G. Movimientos (spec stock-movements, "Consulta de movimientos de un repuesto")
# =============================================================================

### 49. GET /repuestos/{filtro}/movimientos con jefa
# Esperado: 200 con una lista de 2 elementos en orden de registro (id ascendente):
#   {id, cantidad: 5, motivo: "Stock inicial", orden_id: null, usuario_id: <jefa>, cuando}
#   {id, cantidad: 7, motivo: "Compra a proveedor", orden_id: null, usuario_id: <jefa>, cuando}
# Cada elemento tiene exactamente id, cantidad, motivo, orden_id, usuario_id y cuando (con zona);
# sin repuesto_id ni borrado_en.
# @no-cookie-jar
GET {{base}}/repuestos/{{altaFiltro.response.body.$.id}}/movimientos
Cookie: {{loginJefa.response.headers.Set-Cookie}}

### 50. GET /repuestos/{bujia}/movimientos
# Esperado: 200 con 3 elementos en orden: cantidad 4 "Reposición", 1 "Ajuste de inventario" y 100000 "Reposición";
# la suma (100005) es el stock del caso 28.
# @no-cookie-jar
GET {{base}}/repuestos/{{altaBujia.response.body.$.id}}/movimientos
Cookie: {{loginJefa.response.headers.Set-Cookie}}

