# =============================================================================
# test/ordenes.http -- Casos de C-13 ordenes-alta-estados
#   (POST /ordenes -- alta de una orden de trabajo --, GET /estados-orden)
#
# Cliente HTTP: extension REST Client de VS Code (o el cliente HTTP de JetBrains).
# Servidor: .venv\Scripts\python.exe -m uvicorn main:app --port 8000
# Las comprobaciones de filas se hacen con psql (consultas en cada caso).
#
# ESTADO CONOCIDO ANTES DE CORRER EL ARCHIVO DE ARRIBA ABAJO
#   (migrado a la ultima revision; sin seed -- C-06 -- la base queda sin repuestos, ordenes ni
#    catalogo de estados):
#
#   -- 1) vacia el dominio de ordenes y repuestos. El disparador de solo agregado rechaza DELETE en
#   --    historial_estado_orden, movimiento_stock e historial_precio_repuesto, y una orden creada por
#   --    la API no se puede borrar porque su historial la referencia; TRUNCATE no dispara el
#   --    disparador (es la via que usa seed.py para recargar el estado inicial). Sin CASCADE: falla
#   --    si otra tabla los referenciara.
#   --    ATENCION: vacia TODAS las ordenes y TODOS los repuestos, tambien los de otros datos de
#   --    desarrollo.
#   TRUNCATE historial_estado_orden, item_orden, movimiento_stock, historial_precio_repuesto,
#     orden_trabajo, repuesto RESTART IDENTITY;
#
#   -- 2) limpia SOLO lo de este archivo (correos @ordenes.example.com, documentos 460000xx,
#   --    patentes ZO...):
#   DELETE FROM vehiculo WHERE patente LIKE 'ZO%';
#   DELETE FROM evento_seguridad WHERE actor LIKE '%@ordenes.example.com'
#     OR accion LIKE '%@ordenes.example.com%';
#   DELETE FROM intento_acceso WHERE email LIKE '%@ordenes.example.com';
#   DELETE FROM asignacion_rol WHERE usuario_id IN
#     (SELECT id FROM usuario WHERE email LIKE '%@ordenes.example.com')
#     OR otorgada_por IN (SELECT id FROM usuario WHERE email LIKE '%@ordenes.example.com');
#   DELETE FROM vehiculo WHERE cliente_id IN (SELECT id FROM cliente WHERE documento LIKE '460000%');
#   DELETE FROM cliente WHERE documento LIKE '460000%' OR usuario_id IN
#     (SELECT id FROM usuario WHERE email LIKE '%@ordenes.example.com');
#   DELETE FROM usuario WHERE email LIKE '%@ordenes.example.com';
#
#   -- 3) catalogo de estados (C-06 todavia no existe; si ya esta cargado no cambia nada):
#   INSERT INTO estado_orden (codigo, descripcion, posicion, es_final) VALUES
#     ('PENDIENTE', 'Pendiente', 1, false), ('EN_REPARACION', 'En reparación', 2, false),
#     ('TERMINADA', 'Terminada', 3, true), ('CANCELADA', 'Cancelada', 4, true)
#   ON CONFLICT DO NOTHING;
#
# Si C-06 (seed) ya existe, correr `python seed.py` antes y luego el bloque de arriba.
# Rangos propios: correos @ordenes.example.com, documentos 460000xx (C-10 usa 430000xx, C-11 440000xx,
# C-12 450000xx), patentes ZO... (C-10 usa ZC...), codigos de repuesto ORD-... (C-12 usa STK-...).
# El archivo es de una sola pasada sobre ese estado: los ids de repuesto (1 a 6) y de orden (1 a 6)
# salen de RESTART IDENTITY.
#
# Reutilizar una sesion: `Cookie: {{loginRecepcion.response.headers.Set-Cookie}}` (todas las
# peticiones llevan `# @no-cookie-jar`: nada se envia por el jar del cliente).
#
# Personas: jefa (ADMIN), recepcion (RECEPCION), mecanico (MECANICO), duena (solo CLIENTE; su ficha
# es la duena de los vehiculos) y pendiente (debe cambiar la contrasena). Todas se crean por
# registro + INSERT del rol.
# =============================================================================

@base = http://localhost:8000

# =============================================================================
# A. Preparacion
# =============================================================================

### 1. Registro de jefa@ordenes.example.com
# Esperado: 201 con {id, email, nombre, cliente:{...}}
# @name registroJefa
# @no-cookie-jar
POST {{base}}/auth/registro
Content-Type: application/json

{
  "email": "jefa@ordenes.example.com",
  "password": "ClaveSegura1",
  "nombre": "Josefina Jefa",
  "documento": "46000001",
  "telefono": "1146000001"
}

### 2. Registro de recepcion@ordenes.example.com
