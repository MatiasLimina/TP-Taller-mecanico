# =============================================================================
# test/clientes.http -- Casos de C-10 clientes-vehiculos
#   (POST /clientes, GET /clientes/{id}, POST /clientes/{id}/vehiculos,
#    DELETE /vehiculos/{id}, GET /mis-vehiculos)
#
# Cliente HTTP: extension REST Client de VS Code (o el cliente HTTP de JetBrains).
# Servidor: .venv\Scripts\python.exe -m uvicorn main:app --port 8000
# Las comprobaciones de filas se hacen con psql (consultas en cada seccion).
#
# ESTADO CONOCIDO ANTES DE CORRER EL ARCHIVO DE ARRIBA ABAJO
#   (migrado a la ultima revision):
#
#   DELETE FROM orden_trabajo WHERE vehiculo_id IN (SELECT id FROM vehiculo WHERE patente LIKE 'ZC%');
#   DELETE FROM vehiculo WHERE patente LIKE 'ZC%';
#   DELETE FROM evento_seguridad WHERE actor LIKE '%@clientes.example.com';
#   DELETE FROM intento_acceso WHERE email LIKE '%@clientes.example.com';
#   DELETE FROM asignacion_rol WHERE usuario_id IN (SELECT id FROM usuario WHERE email LIKE '%@clientes.example.com');
#   DELETE FROM cliente WHERE documento LIKE '430000%' OR usuario_id IN (SELECT id FROM usuario WHERE email LIKE '%@clientes.example.com');
#   DELETE FROM usuario WHERE email LIKE '%@clientes.example.com';
#   -- catalogo de estados (C-06 todavia no existe; si ya esta cargado no cambia nada):
#   INSERT INTO estado_orden (codigo, descripcion, posicion, es_final) VALUES
#     ('PENDIENTE', 'Pendiente', 1, false), ('EN_REPARACION', 'En reparación', 2, false),
#     ('TERMINADA', 'Terminada', 3, true), ('CANCELADA', 'Cancelada', 4, true)
#   ON CONFLICT DO NOTHING;
#
# Correos @clientes.example.com, documentos 430000xx, patentes ZC...; archivo de una
# sola pasada; si C-06 ya existe, `python seed.py` antes y despues este bloque.
# Reutilizar una sesion: `Cookie: {{loginRecepcion.response.headers.Set-Cookie}}` (todas las
# peticiones llevan `# @no-cookie-jar`).
# =============================================================================

@base = http://localhost:8000

# =============================================================================
# A. Preparacion
# =============================================================================

### 1. Registro de recepcion@clientes.example.com
# Esperado: 201
# @name registroRecepcion
# @no-cookie-jar
POST {{base}}/auth/registro
Content-Type: application/json

{
  "email": "recepcion@clientes.example.com",
  "password": "ClaveSegura1",
  "nombre": "Rita Recepcion",
  "documento": "43000001",
  "telefono": "1143000001"
}

### 2. Registro de admin@clientes.example.com
