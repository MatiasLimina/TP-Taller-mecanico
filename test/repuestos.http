# psql: conservan stock y movimiento:
#   SELECT stock, borrado_en IS NOT NULL FROM repuesto WHERE codigo = 'PAS-FRE-DEL';  -- 4 | t
#   SELECT count(*) FROM movimiento_stock WHERE repuesto_id = (SELECT id FROM repuesto WHERE codigo = 'PAS-FRE-DEL');  -- 1
# @no-cookie-jar
DELETE {{base}}/repuestos/{{altaPastillas.response.body.$.id}}
Cookie: {{loginJefa.response.headers.Set-Cookie}}

