### 21. Login correcto
# Esperado: 200 con el cuerpo EXACTO
#   {"mensaje": "Sesión iniciada", "debe_cambiar_password": false, "expira_en_segundos": 1800}
#   (sin token ni otros campos) y
#   Set-Cookie: access_token=<jwt>; HttpOnly; Max-Age=1800; Path=/; SameSite=lax
# psql: SELECT email, ip, exito FROM intento_acceso WHERE email = 'ana@example.com';
#   -- una fila exito=t
# @name login_ok
# @no-cookie-jar
POST {{base}}/auth/login
Content-Type: application/json

{
  "email": "ana@example.com",
  "password": "ClaveSegura1"
}

### 22. Login con el correo en mayusculas y con espacios (S-01)
# Esperado: 200 igual que el caso 21 (el correo normalizado es el mismo usuario)
# @no-cookie-jar
POST {{base}}/auth/login
Content-Type: application/json

{
  "email": " ANA@example.com ",
  "password": "ClaveSegura1"
}

### 23. La cuenta recien registrada inicia sesion (contrasena de 72 bytes)
# Esperado: 200
# @no-cookie-jar
POST {{base}}/auth/login
Content-Type: application/json

{
  "email": "frank@example.com",
  "password": "ññññññññññññññññññññññññññññññññññññ"
}

# Cambio de contrasena pendiente / roles vigentes en el token: se verifican por script
# (psql UPDATE usuario SET debe_cambiar_password = true; asignaciones revocada/vencida y
# decodificar_token_acceso). Ver "Verificados por script" al pie.

# =============================================================================
# C-04 -- Credenciales rechazadas sin revelar la cuenta (RN09)
# =============================================================================

### 24. Contrasena incorrecta de un correo existente
# Esperado: 401 {"detail": "Correo o contraseña incorrectos"}, sin Set-Cookie
# @no-cookie-jar
POST {{base}}/auth/login
Content-Type: application/json

{
  "email": "carla@example.com",
  "password": "ContrasenaEquivocada"
}

### 25. Correo inexistente
# Esperado: 401 con cuerpo IDENTICO byte a byte al del caso 24, sin Set-Cookie
# psql: SELECT email, exito FROM intento_acceso WHERE email = 'fantasma@example.com';
#   -- una fila exito=f (el correo inexistente tambien se anota)
# @no-cookie-jar
POST {{base}}/auth/login
Content-Type: application/json

{
  "email": "fantasma@example.com",
  "password": "ContrasenaEquivocada"
}

### 26. Usuario inactivo con contrasena correcta
# Antes (psql): UPDATE usuario SET activo = false WHERE email = 'dario@example.com';
# Esperado: 401 {"detail": "Correo o contraseña incorrectos"} sin Set-Cookie
# Despues (psql): UPDATE usuario SET activo = true WHERE email = 'dario@example.com';
# @no-cookie-jar
POST {{base}}/auth/login
Content-Type: application/json

{
  "email": "dario@example.com",
  "password": "ClaveSegura1"
}

# =============================================================================
# Contrato del login
# =============================================================================

