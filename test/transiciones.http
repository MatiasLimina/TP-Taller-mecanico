# @no-cookie-jar
POST {{base}}/ordenes/999999/iniciar
Cookie: {{loginMecanico.response.headers.Set-Cookie}}

### 45. terminar una orden inexistente con loginDuena (404, no 403: la orden se busca primero, S-07)
# Esperado: 404 {"detail": "La orden no existe"}
# @no-cookie-jar
POST {{base}}/ordenes/999999/terminar
Cookie: {{loginDuena.response.headers.Set-Cookie}}

### 46. cancelar una orden inexistente con loginAjeno (404, no 403)
# Esperado: 404 {"detail": "La orden no existe"}
# @no-cookie-jar
POST {{base}}/ordenes/999999/cancelar
Cookie: {{loginAjeno.response.headers.Set-Cookie}}

### 47. GET /ordenes/1/iniciar: la ruta solo admite POST
# Esperado: 405 (antes de C-14, sin la ruta, Starlette responde 404 o 405: anotar cual)
# psql: los rechazos de esta seccion no cambiaron nada:
#   SELECT count(*) FROM orden_trabajo WHERE estado = 'PENDIENTE' AND mecanico_id IS NULL;  -- 8
#   SELECT count(*) FROM historial_estado_orden;  -- 8
# @no-cookie-jar
GET {{base}}/ordenes/1/iniciar
Cookie: {{loginMecanico.response.headers.Set-Cookie}}

# =============================================================================
# C. Catalogo guiado por la base (spec 'Reglas de estado guiadas por el catalogo', S-10)
