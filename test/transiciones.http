Cookie: {{loginJefa.response.headers.Set-Cookie}}

### 43. cancelar con id por encima de INT4 (2147483648)
# Esperado: 422 con detail[].loc ["path", "orden_id"] (le 2147483647; NO 500)
# @no-cookie-jar
POST {{base}}/ordenes/2147483648/cancelar
Cookie: {{loginRecepcion.response.headers.Set-Cookie}}

