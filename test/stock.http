# =============================================================================
# test/stock.http -- Casos de C-12 repuestos-stock-precios
#   (reposicion: POST /repuestos/{id}/reponer; historiales: GET /repuestos/{id}/movimientos
#    y GET /repuestos/{id}/precios; todo solo ADMIN. La reposicion usa el punto unico de
#    escritura de stock (RN14); el historial de precios lo escribe el PATCH de C-11 (RN20))
#
# Cliente HTTP: extension REST Client de VS Code (o el cliente HTTP de JetBrains).
# Servidor: .venv\Scripts\python.exe -m uvicorn main:app --port 8000
# Las comprobaciones de filas se hacen con psql (consultas en cada caso).
#
# ESTADO CONOCIDO ANTES DE CORRER EL ARCHIVO DE ARRIBA ABAJO
#   (migrado a la ultima revision; sin seed -- C-06 -- la base queda sin repuestos ni usuarios):
#
#   -- 1) vacia el dominio de repuestos. El disparador de solo agregado rechaza DELETE en
#   --    movimiento_stock e historial_precio_repuesto; TRUNCATE no lo dispara (es la via que usa
#   --    seed.py para recargar el estado inicial). Sin CASCADE: falla si otra tabla los referenciara.
#   --    ATENCION: vacia TODOS los repuestos, tambien los de test/repuestos.http y de otros datos
#   --    de desarrollo (mismo criterio que C-11 S-14).
#   TRUNCATE item_orden, movimiento_stock, historial_precio_repuesto, repuesto RESTART IDENTITY;
#
#   -- 2) limpia SOLO los usuarios de este archivo (todos sus correos terminan en @stock.example.com):
#   DELETE FROM evento_seguridad WHERE actor LIKE '%@stock.example.com'
#     OR accion LIKE '%@stock.example.com%';
#   DELETE FROM intento_acceso WHERE email LIKE '%@stock.example.com';
#   DELETE FROM asignacion_rol WHERE usuario_id IN
#     (SELECT id FROM usuario WHERE email LIKE '%@stock.example.com')
#     OR otorgada_por IN (SELECT id FROM usuario WHERE email LIKE '%@stock.example.com');
#   DELETE FROM cliente WHERE documento IN ('45000001', '45000002', '45000003', '45000004') OR usuario_id IN
#     (SELECT id FROM usuario WHERE email LIKE '%@stock.example.com');
#   DELETE FROM usuario WHERE email LIKE '%@stock.example.com';
#
# Si C-06 (seed) ya existe, correr `python seed.py` antes y luego el bloque de arriba.
# Los correos, documentos y codigos de este archivo son unicos: el archivo es de una sola
# pasada sobre ese estado.
#
# Reutilizar una sesion: `Cookie: {{loginJefa.response.headers.Set-Cookie}}` (todas las
# peticiones llevan `# @no-cookie-jar`: nada se envia por el jar del cliente).
#
# Personas: jefa (ADMIN), recepcion (RECEPCION), mecanico (MECANICO) -- las tres creadas por
# registro + INSERT del rol -- y cliente (solo CLIENTE).
# Repuestos: filtro (STK-FIL-01), bujia (STK-BUJ-01), aceite (STK-ACE-01) y baja (STK-BAJ-01).
# =============================================================================

@base = http://localhost:8000

# =============================================================================
# A. Preparacion
# =============================================================================

### 1. Registro de jefa@stock.example.com
# Esperado: 201 con {id, email: "jefa@stock.example.com", nombre, cliente:{...}}
# Despues (psql): jefa pasa a ser ADMIN:
#   INSERT INTO asignacion_rol (usuario_id, rol)
#     SELECT id, 'ADMIN' FROM usuario WHERE email = 'jefa@stock.example.com';
# @name registroJefa
# @no-cookie-jar
POST {{base}}/auth/registro
Content-Type: application/json

{
  "email": "jefa@stock.example.com",
  "password": "ClaveSegura1",
  "nombre": "Josefina Jefa",
  "documento": "45000001",
  "telefono": "1155550001"
}

### 2. Registro de recepcion@stock.example.com
# Esperado: 201
# Despues (psql): recepcion pasa a ser RECEPCION:
#   INSERT INTO asignacion_rol (usuario_id, rol)
#     SELECT id, 'RECEPCION' FROM usuario WHERE email = 'recepcion@stock.example.com';
# @name registroRecepcion
# @no-cookie-jar
POST {{base}}/auth/registro
Content-Type: application/json

{
  "email": "recepcion@stock.example.com",
  "password": "ClaveSegura1",
  "nombre": "Rita Recepcion",
  "documento": "45000002",
  "telefono": "1155550002"
}

### 3. Registro de mecanico@stock.example.com
# Esperado: 201
# Despues (psql): mecanico pasa a ser MECANICO:
#   INSERT INTO asignacion_rol (usuario_id, rol)
#     SELECT id, 'MECANICO' FROM usuario WHERE email = 'mecanico@stock.example.com';
# @name registroMecanico
# @no-cookie-jar
POST {{base}}/auth/registro
Content-Type: application/json

{
  "email": "mecanico@stock.example.com",
  "password": "ClaveSegura1",
  "nombre": "Mario Mecanico",
  "documento": "45000003",
  "telefono": "1155550003"
}

### 4. Registro de cliente@stock.example.com
# Esperado: 201 (queda solo CLIENTE)
# @name registroCliente
# @no-cookie-jar
POST {{base}}/auth/registro
Content-Type: application/json

{
  "email": "cliente@stock.example.com",
  "password": "ClaveSegura1",
  "nombre": "Carlos Cliente",
  "documento": "45000004",
  "telefono": "1155550004"
}

### 5. Login de jefa (despues del INSERT de rol del caso 1)
# Esperado: 200 con Set-Cookie: access_token=<jwt>; HttpOnly; Max-Age=1800; Path=/; SameSite=lax
# @name loginJefa
# @no-cookie-jar
POST {{base}}/auth/login
Content-Type: application/json

{
  "email": "jefa@stock.example.com",
  "password": "ClaveSegura1"
}

### 6. Login de recepcion
# Esperado: 200
# @name loginRecepcion
# @no-cookie-jar
POST {{base}}/auth/login
Content-Type: application/json

{
  "email": "recepcion@stock.example.com",
  "password": "ClaveSegura1"
}

### 7. Login de mecanico
# Esperado: 200
# @name loginMecanico
# @no-cookie-jar
POST {{base}}/auth/login
Content-Type: application/json

{
  "email": "mecanico@stock.example.com",
  "password": "ClaveSegura1"
}

### 8. Login de cliente
# Esperado: 200
# @name loginCliente
# @no-cookie-jar
POST {{base}}/auth/login
Content-Type: application/json

{
  "email": "cliente@stock.example.com",
  "password": "ClaveSegura1"
}

