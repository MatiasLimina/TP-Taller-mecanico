### 5. Registro de pendiente@ordenes.example.com
# Esperado: 201
# Despues (psql): jefa pasa a ser ADMIN, recepcion RECEPCION, mecanico MECANICO, y pendiente debe
# cambiar la contrasena:
#   INSERT INTO asignacion_rol (usuario_id, rol)
#     SELECT id, 'ADMIN' FROM usuario WHERE email = 'jefa@ordenes.example.com';
#   INSERT INTO asignacion_rol (usuario_id, rol)
#     SELECT id, 'RECEPCION' FROM usuario WHERE email = 'recepcion@ordenes.example.com';
#   INSERT INTO asignacion_rol (usuario_id, rol)
#     SELECT id, 'MECANICO' FROM usuario WHERE email = 'mecanico@ordenes.example.com';
#   UPDATE usuario SET debe_cambiar_password = true WHERE email = 'pendiente@ordenes.example.com';
# @no-cookie-jar
POST {{base}}/auth/registro
Content-Type: application/json

{
  "email": "pendiente@ordenes.example.com",
  "password": "ClaveSegura1",
  "nombre": "Pablo Pendiente",
  "documento": "46000005",
  "telefono": "1146000005"
}

