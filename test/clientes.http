# psql: SELECT id, cliente_id, borrado_en IS NOT NULL AS dado_de_baja FROM vehiculo WHERE patente = 'ZC003AA' ORDER BY id -- 2 filas: la primera de duena dada de baja, la segunda de otro vigente
