GET {{base}}/ordenes
Cookie: {{loginMecanico2.response.headers.Set-Cookie}}

### 17. GET /ordenes con loginAdmin
# Esperado: 200 con total 3
# @no-cookie-jar
GET {{base}}/ordenes
Cookie: {{loginAdmin.response.headers.Set-Cookie}}


# =============================================================================
# C. Listado y filtro (casos 18-32; todos con loginRecepcion)
# =============================================================================

### 18. GET /ordenes: mas nueva primero
# Esperado: 200 con {items: [3, 2, 1], total: 3, page: 1, size: 20, pages: 1}; resumen de la 3: {id: 3, estado: "PENDIENTE",
#   patente: "AC456EF", total: "57000.00", creada_en, mecanico_id: null, falla: "Revisión general con cuatro repuestos",
#   cliente: "Laura Martínez"}; de la 2: {estado: "EN_REPARACION", patente: "AD789GH", total: "18000.00", mecanico_id: 4,
#   falla: "El motor falla en frío y tironea al acelerar", cliente: "Jorge Pérez"}; de la 1: {estado: "PENDIENTE",
#   patente: "AB123CD", total: "56500.00", mecanico_id: null, falla: "Service de los 30.000 km: cambio de aceite y filtro",
#   cliente: "Laura Martínez"}; ningun elemento tiene items ni historial
# Con SQL_ECHO=true: un SELECT count(*) y un unico SELECT con LEFT OUTER JOIN vehiculo AS vehiculo_1, LEFT OUTER JOIN
#   cliente AS cliente_1 y ORDER BY orden_trabajo.id DESC, sin FOR UPDATE
# @no-cookie-jar
GET {{base}}/ordenes
Cookie: {{loginRecepcion.response.headers.Set-Cookie}}

### 19. GET /ordenes?estado=PENDIENTE
