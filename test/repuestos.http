### 83. Alta con el codigo liberado por la baja
# Esperado: 201 con un "id" distinto del de la bujia dada de baja, "precio": "4600.00", "stock": 2
# psql: dos filas BUJ-01 (una con borrado_en) y un movimiento de la nueva:
#   SELECT id, borrado_en IS NOT NULL FROM repuesto WHERE codigo = 'BUJ-01' ORDER BY id;  -- (3, t) y (<n>, f)
#     (el id nuevo no es el 5: el 409 del caso 20 consumio un valor de la secuencia)
#   SELECT cantidad FROM movimiento_stock WHERE repuesto_id = (SELECT id FROM repuesto WHERE codigo = 'BUJ-01' AND borrado_en IS NULL);  -- 2
# @name altaBujia2
# @no-cookie-jar
POST {{base}}/repuestos
Content-Type: application/json
Cookie: {{loginJefa.response.headers.Set-Cookie}}

{
  "codigo": "BUJ-01",
  "descripcion": "Bujía",
  "precio": 4600,
  "stock_inicial": 2
}

### 84. Busqueda de la bujia nueva
# Esperado: 200 con 1 item (la nueva, "stock": 2), "total": 1
# @no-cookie-jar
GET {{base}}/repuestos?q=buj
Cookie: {{loginJefa.response.headers.Set-Cookie}}

