# =============================================================================
# B. Catalogo de estados (spec order-states)
# =============================================================================

### 22. GET /estados-orden sin cookie
# Esperado: 401 {"detail": "Se requiere iniciar sesión"}
# @no-cookie-jar
GET {{base}}/estados-orden

### 23. GET /estados-orden con un usuario que debe cambiar la contrasena
# Esperado: 403 {"detail": "Debe cambiar la contraseña antes de continuar"}
# @no-cookie-jar
GET {{base}}/estados-orden
Cookie: {{loginPendiente.response.headers.Set-Cookie}}

### 24. GET /estados-orden con la sesion de un cliente (solo CLIENTE): cualquier autenticado
# Esperado: 200 exactamente los cuatro estados en orden de posicion:
#   [{"codigo": "PENDIENTE", "descripcion": "Pendiente", "posicion": 1, "es_final": false}, {"codigo": "EN_REPARACION", "descripcion": "En reparación", "posicion": 2, "es_final": false}, {"codigo": "TERMINADA", "descripcion": "Terminada", "posicion": 3, "es_final": true}, {"codigo": "CANCELADA", "descripcion": "Cancelada", "posicion": 4, "es_final": true}]
# @no-cookie-jar
GET {{base}}/estados-orden
Cookie: {{loginDuena.response.headers.Set-Cookie}}

### 25. GET /estados-orden con la sesion de mecanico
# Esperado: 200 igual que el caso 24
# @no-cookie-jar
GET {{base}}/estados-orden
Cookie: {{loginMecanico.response.headers.Set-Cookie}}

### 26. POST /estados-orden: el catalogo no se escribe por la API (RN19)
# Esperado: 405
# Despues (psql): se vacia el catalogo (todavia no hay ordenes que lo referencien):
#   DELETE FROM estado_orden;
# @no-cookie-jar
POST {{base}}/estados-orden
Cookie: {{loginJefa.response.headers.Set-Cookie}}

### 27. GET /estados-orden con el catalogo vacio
# Esperado: 200 []
# @no-cookie-jar
GET {{base}}/estados-orden
Cookie: {{loginDuena.response.headers.Set-Cookie}}

### 28. POST /ordenes valido con el catalogo vacio (RN19)
# Esperado: 409 {"detail": "No se pueden crear órdenes: el catálogo de estados está vacío o no tiene el estado PENDIENTE"}
# psql: no se escribio nada:
#   SELECT count(*) FROM orden_trabajo;  -- 0
#   SELECT count(*) FROM item_orden;  -- 0
#   SELECT count(*) FROM historial_estado_orden;  -- 0
# Despues (psql): se carga el catalogo SIN el estado PENDIENTE:
#   INSERT INTO estado_orden (codigo, descripcion, posicion, es_final) VALUES
#     ('EN_REPARACION', 'En reparación', 2, false), ('TERMINADA', 'Terminada', 3, true),
#     ('CANCELADA', 'Cancelada', 4, true);
# @no-cookie-jar
POST {{base}}/ordenes
Content-Type: application/json
Cookie: {{loginRecepcion.response.headers.Set-Cookie}}

{
  "vehiculo_id": {{vehDuena.response.body.$.id}},
  "falla": "Ruido al frenar",
  "items": [
    {"repuesto_id": 2, "cantidad": 1},
    {"repuesto_id": 4, "cantidad": 3}
  ]
}

### 29. GET /estados-orden con el catalogo parcial
# Esperado: 200 los tres cargados, en orden de posicion (EN_REPARACION, TERMINADA, CANCELADA)
# @no-cookie-jar
GET {{base}}/estados-orden
Cookie: {{loginDuena.response.headers.Set-Cookie}}

### 30. POST /ordenes valido con el catalogo sin PENDIENTE (mismo mensaje)
# Esperado: 409 {"detail": "No se pueden crear órdenes: el catálogo de estados está vacío o no tiene el estado PENDIENTE"}
# psql: no se escribio nada:
#   SELECT count(*) FROM orden_trabajo;  -- 0
#   SELECT count(*) FROM item_orden;  -- 0
#   SELECT count(*) FROM historial_estado_orden;  -- 0
# Despues (psql): se completa el catalogo (mismo INSERT del encabezado):
#   INSERT INTO estado_orden (codigo, descripcion, posicion, es_final) VALUES
#     ('PENDIENTE', 'Pendiente', 1, false), ('EN_REPARACION', 'En reparación', 2, false),
#     ('TERMINADA', 'Terminada', 3, true), ('CANCELADA', 'Cancelada', 4, true)
#   ON CONFLICT DO NOTHING;
# @no-cookie-jar
POST {{base}}/ordenes
Content-Type: application/json
Cookie: {{loginRecepcion.response.headers.Set-Cookie}}

{
  "vehiculo_id": {{vehDuena.response.body.$.id}},
  "falla": "Ruido al frenar",
  "items": [
    {"repuesto_id": 2, "cantidad": 1},
    {"repuesto_id": 4, "cantidad": 3}
  ]
}

### 31. GET /estados-orden con el catalogo completo otra vez
# Esperado: 200 los cuatro estados (como el caso 24)
# @no-cookie-jar
GET {{base}}/estados-orden
Cookie: {{loginDuena.response.headers.Set-Cookie}}

