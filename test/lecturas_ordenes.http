# =============================================================================
# test/lecturas_ordenes.http -- Casos de C-15 ordenes-lecturas-sin-n-plus-1
#   (GET /ordenes, GET /ordenes/{id}, GET /mis-ordenes -- las lecturas de ordenes de trabajo:
#    listado del personal con filtro por estado, detalle para el personal o el dueño del
#    vehiculo y ordenes propias del usuario autenticado; casos del PDF C-15 -detalle con 2 y con
#    4 items con las mismas sentencias SQL- y C-17 -catalogo de estados y filtro por un estado que
#    el contrato no declara-)
#
# Cliente HTTP: extension REST Client de VS Code (o el cliente HTTP de JetBrains).
# Servidor: .venv\Scripts\python.exe -m uvicorn main:app --port 8000
#   Para ver las consultas SQL de cada peticion en la consola de uvicorn (SQL_ECHO), levantarlo asi:
#   $env:SQL_ECHO="true"; .venv\Scripts\python.exe -m uvicorn main:app --port 8000
# Las comprobaciones de filas se hacen con psql (consultas en los casos que lo piden).
#
# ESTADO CONOCIDO: `.venv\Scripts\python.exe seed.py` inmediatamente antes. Para repetir el
# archivo, volver a correr el seed (el archivo crea la orden 3, la cancela y da de baja el
# vehiculo 2; el seed vacia las 13 tablas con RESTART IDENTITY y recarga todo).
#
# Ids del seed (C-06), deterministas por RESTART IDENTITY:
#   Usuarios: 1 admin@example.com (ADMIN), 2 admin2@example.com (ADMIN), 3 recepcion@example.com
#     (RECEPCION), 4 mecanico@example.com (MECANICO), 5 mecanico2@example.com (MECANICO),
#     6 cliente@example.com (CLIENTE, ficha "Laura Martínez"), 7 nuevo@example.com (MECANICO, con
#     cambio de contraseña pendiente).
#   Fichas de cliente: 1 Laura Martínez (usuario 6), 2 Jorge Pérez (sin usuario).
#   Vehiculos: 1 AB123CD y 2 AC456EF (Laura), 3 AD789GH (Jorge).
#   Repuestos: 1 FIL-ACE-01 (8500), 2 PAS-FRE-DEL (32000), 3 BUJ-01 (4500), 4 ACE-5W30-1L (12000).
#   Ordenes: 1 (vehiculo 1, PENDIENTE, items FIL-ACE-01 x 1 y ACE-5W30-1L x 4, total 56500.00,
#     historial null -> PENDIENTE por 3); 2 (vehiculo 3, EN_REPARACION, mecanico 4, BUJ-01 x 4,
#     total 18000.00, historial null -> PENDIENTE por 3 y PENDIENTE -> EN_REPARACION por 4).
#   Contraseñas: ClaveSegura1 (y Provisoria1 para nuevo@example.com).
#
# Lo que agrega el archivo con la API: el usuario 8 ajeno@lecturas.example.com (documento
# 48000001, ficha 3 sin vehiculos) y la orden 3 de CUATRO items (vehiculo 2, repuestos 1 a 4 x 1,
# total 57000.00) para el caso PDF C-15. Al final, la duena cancela la orden 3 y la recepcion da de
# baja el vehiculo 2 (S-09, RN16).
#
# Reutilizar una sesion: `Cookie: {{loginRecepcion.response.headers.Set-Cookie}}` (todas las
# peticiones llevan `# @no-cookie-jar`: nada se envia por el jar del cliente).
#
# Un "resumen" es un elemento de un listado: exactamente {id, estado, patente, total, creada_en,
# mecanico_id, falla, cliente}. Un "detalle" es el cuerpo de OrdenDetalleSalida (el del alta y las
# transiciones). Las fechas salen con zona (Z o +00:00).
# =============================================================================

@base = http://localhost:8000


# =============================================================================
# A. Preparacion (casos 1-9)
# =============================================================================

### 1. Login de admin@example.com
# Esperado: 200 con debe_cambiar_password: false
# @name loginAdmin
# @no-cookie-jar
POST {{base}}/auth/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "ClaveSegura1"
}

### 2. Login de recepcion@example.com
# Esperado: 200 con debe_cambiar_password: false
# @name loginRecepcion
# @no-cookie-jar
POST {{base}}/auth/login
Content-Type: application/json

{
  "email": "recepcion@example.com",
  "password": "ClaveSegura1"
}

### 3. Login de mecanico@example.com
# Esperado: 200 con debe_cambiar_password: false
# @name loginMecanico
# @no-cookie-jar
POST {{base}}/auth/login
Content-Type: application/json

{
  "email": "mecanico@example.com",
  "password": "ClaveSegura1"
}

### 4. Login de mecanico2@example.com
# Esperado: 200 con debe_cambiar_password: false
# @name loginMecanico2
# @no-cookie-jar
POST {{base}}/auth/login
Content-Type: application/json

{
  "email": "mecanico2@example.com",
  "password": "ClaveSegura1"
}

### 5. Login de cliente@example.com
# Esperado: 200 con debe_cambiar_password: false
# @name loginCliente
# @no-cookie-jar
POST {{base}}/auth/login
Content-Type: application/json

{
  "email": "cliente@example.com",
  "password": "ClaveSegura1"
}

### 6. Login de nuevo@example.com
# Esperado: 200 con debe_cambiar_password: true
# @name loginNuevo
# @no-cookie-jar
POST {{base}}/auth/login
Content-Type: application/json

{
  "email": "nuevo@example.com",
  "password": "Provisoria1"
}

### 7. Registro de ajeno@lecturas.example.com (ficha sin vehiculos)
# Esperado: 201 con id 8 y cliente.id 3 (el usuario 8 y la ficha 3)
# psql: SELECT id, email FROM usuario WHERE email = 'ajeno@lecturas.example.com'
# Esperado (psql): una fila con id 8
# @name registroAjeno
# @no-cookie-jar
POST {{base}}/auth/registro
Content-Type: application/json

{
  "email": "ajeno@lecturas.example.com",
  "password": "ClaveSegura1",
  "nombre": "Ana Ajena",
  "documento": "48000001",
  "telefono": "1148000001"
}

### 8. Login de ajeno@lecturas.example.com
# Esperado: 200 con debe_cambiar_password: false
# @name loginAjeno
# @no-cookie-jar
POST {{base}}/auth/login
Content-Type: application/json

{
  "email": "ajeno@lecturas.example.com",
  "password": "ClaveSegura1"
}

### 9. Alta de la orden 3: vehiculo 2 con CUATRO items (caso PDF C-15, parte 2)
# Esperado: 201 con el detalle {id: 3, estado: "PENDIENTE", patente: "AC456EF", total: "57000.00", mecanico_id: null,
#   falla: "Revisión general con cuatro repuestos", cliente: "Laura Martínez", items: [FIL-ACE-01 1 "8500.00"/"8500.00",
#   PAS-FRE-DEL 1 "32000.00"/"32000.00", BUJ-01 1 "4500.00"/"4500.00", ACE-5W30-1L 1 "12000.00"/"12000.00"],
#   historial: [{null -> PENDIENTE, usuario_id 3}]}
# psql: SELECT id, vehiculo_id, estado, total FROM orden_trabajo ORDER BY id
# Esperado (psql): 1 1 PENDIENTE 56500.00; 2 3 EN_REPARACION 18000.00; 3 2 PENDIENTE 57000.00
# @name alta4
# @no-cookie-jar
POST {{base}}/ordenes
Content-Type: application/json
Cookie: {{loginRecepcion.response.headers.Set-Cookie}}

{
  "vehiculo_id": 2,
  "falla": "Revisión general con cuatro repuestos",
  "items": [
    {"repuesto_id": 1, "cantidad": 1},
    {"repuesto_id": 2, "cantidad": 1},
    {"repuesto_id": 3, "cantidad": 1},
    {"repuesto_id": 4, "cantidad": 1}
  ]
}


# =============================================================================
# B. Acceso al listado: requisito "Listado de ordenes solo para el personal" (casos 10-17)
# =============================================================================

### 10. GET /ordenes sin cookie
