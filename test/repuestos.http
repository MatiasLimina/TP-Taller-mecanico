# =============================================================================
# test/repuestos.http -- Casos de C-11 repuestos-catalogo
#   (catalogo: GET /repuestos, GET /repuestos/{id}; escrituras solo ADMIN: POST /repuestos,
#    PATCH /repuestos/{id}, DELETE /repuestos/{id}; stock inicial por el punto unico de
#    escritura de stock (RN14); historial de precios en el PATCH (RN20))
#
# Cliente HTTP: extension REST Client de VS Code (o el cliente HTTP de JetBrains).
# Servidor: .venv\Scripts\python.exe -m uvicorn main:app --port 8000
# Las comprobaciones de filas se hacen con psql (consultas en cada caso).
#
# ESTADO CONOCIDO ANTES DE CORRER EL ARCHIVO DE ARRIBA ABAJO
#   (migrado a la ultima revision; sin seed -- C-06 -- la base queda sin repuestos ni usuarios):
#
#   -- 1) vacia el dominio de repuestos. El disparador de solo agregado rechaza DELETE en
#   --    movimiento_stock e historial_precio_repuesto; TRUNCATE no lo dispara (es la via que usa
#   --    seed.py para recargar el estado inicial). Sin CASCADE: falla si otra tabla los referenciara.
#   --    ATENCION: vacia TODOS los repuestos, tambien los de otros datos de desarrollo.
#   TRUNCATE item_orden, movimiento_stock, historial_precio_repuesto, repuesto RESTART IDENTITY;
#
#   -- 2) limpia SOLO los usuarios de este archivo (todos sus correos terminan en @repuestos.example.com):
#   DELETE FROM evento_seguridad WHERE actor LIKE '%@repuestos.example.com'
#     OR accion LIKE '%@repuestos.example.com%';
#   DELETE FROM intento_acceso WHERE email LIKE '%@repuestos.example.com';
#   DELETE FROM asignacion_rol WHERE usuario_id IN
#     (SELECT id FROM usuario WHERE email LIKE '%@repuestos.example.com')
#     OR otorgada_por IN (SELECT id FROM usuario WHERE email LIKE '%@repuestos.example.com');
#   DELETE FROM cliente WHERE documento IN ('44000001', '44000002', '44000003', '44000004') OR usuario_id IN
#     (SELECT id FROM usuario WHERE email LIKE '%@repuestos.example.com');
#   DELETE FROM usuario WHERE email LIKE '%@repuestos.example.com';
#
# Si C-06 (seed) ya existe, correr `python seed.py` antes y luego el bloque de arriba.
# Los correos, documentos y codigos de este archivo son unicos: el archivo es de una sola
# pasada sobre ese estado.
#
# Reutilizar una sesion: `Cookie: {{loginJefa.response.headers.Set-Cookie}}` (todas las
# peticiones llevan `# @no-cookie-jar`: nada se envia por el jar del cliente).
#
# Personas: jefa (ADMIN), recepcion (RECEPCION), mecanico (MECANICO) -- las tres creadas por
# registro + INSERT del rol -- y cliente (solo CLIENTE). Los caracteres especiales de `q` van
# codificados en la URL.
# =============================================================================

@base = http://localhost:8000

# =============================================================================
# A. Preparacion
# =============================================================================

### 1. Registro de jefa@repuestos.example.com
# Esperado: 201 con {id, email: "jefa@repuestos.example.com", nombre, cliente:{...}}
# Despues (psql): jefa pasa a ser ADMIN:
#   INSERT INTO asignacion_rol (usuario_id, rol)
#     SELECT id, 'ADMIN' FROM usuario WHERE email = 'jefa@repuestos.example.com';
# @name registroJefa
# @no-cookie-jar
POST {{base}}/auth/registro
Content-Type: application/json

{
  "email": "jefa@repuestos.example.com",
  "password": "ClaveSegura1",
  "nombre": "Josefina Jefa",
  "documento": "44000001",
  "telefono": "1155550001"
}

### 2. Registro de recepcion@repuestos.example.com
# Esperado: 201
# Despues (psql): recepcion pasa a ser RECEPCION:
#   INSERT INTO asignacion_rol (usuario_id, rol)
#     SELECT id, 'RECEPCION' FROM usuario WHERE email = 'recepcion@repuestos.example.com';
# @name registroRecepcion
# @no-cookie-jar
POST {{base}}/auth/registro
Content-Type: application/json

{
  "email": "recepcion@repuestos.example.com",
  "password": "ClaveSegura1",
  "nombre": "Rita Recepcion",
  "documento": "44000002",
  "telefono": "1155550002"
}

### 3. Registro de mecanico@repuestos.example.com
# Esperado: 201
# Despues (psql): mecanico pasa a ser MECANICO:
#   INSERT INTO asignacion_rol (usuario_id, rol)
#     SELECT id, 'MECANICO' FROM usuario WHERE email = 'mecanico@repuestos.example.com';
# @name registroMecanico
# @no-cookie-jar
POST {{base}}/auth/registro
Content-Type: application/json

{
  "email": "mecanico@repuestos.example.com",
  "password": "ClaveSegura1",
  "nombre": "Mario Mecanico",
  "documento": "44000003",
  "telefono": "1155550003"
}

### 4. Registro de cliente@repuestos.example.com (queda solo CLIENTE)
# Esperado: 201
# @name registroCliente
# @no-cookie-jar
POST {{base}}/auth/registro
Content-Type: application/json

{
  "email": "cliente@repuestos.example.com",
  "password": "ClaveSegura1",
  "nombre": "Carlos Cliente",
  "documento": "44000004",
  "telefono": "1155550004"
}

### 5. Login de jefa (despues del INSERT de rol del caso 1)
# Esperado: 200 con Set-Cookie: access_token=<jwt>; HttpOnly; Max-Age=1800; Path=/; SameSite=lax
# @name loginJefa
# @no-cookie-jar
POST {{base}}/auth/login
Content-Type: application/json

{
  "email": "jefa@repuestos.example.com",
  "password": "ClaveSegura1"
}

### 6. Login de recepcion
# Esperado: 200
# @name loginRecepcion
# @no-cookie-jar
POST {{base}}/auth/login
Content-Type: application/json

{
  "email": "recepcion@repuestos.example.com",
  "password": "ClaveSegura1"
}

### 7. Login de mecanico
# Esperado: 200
# @name loginMecanico
# @no-cookie-jar
POST {{base}}/auth/login
Content-Type: application/json

{
  "email": "mecanico@repuestos.example.com",
  "password": "ClaveSegura1"
}

### 8. Login de cliente
# Esperado: 200
# @name loginCliente
# @no-cookie-jar
POST {{base}}/auth/login
Content-Type: application/json

{
  "email": "cliente@repuestos.example.com",
  "password": "ClaveSegura1"
}

# =============================================================================
# B. Acceso (spec parts-catalog, "Acceso al catalogo por rol")
# =============================================================================

### 9. GET /repuestos sin cookie
# Esperado: 401 {"detail": "Se requiere iniciar sesión"}
# @no-cookie-jar
GET {{base}}/repuestos

### 10. GET /repuestos con la sesion de un cliente (solo CLIENTE)
# Esperado: 403 {"detail": "No tiene permiso para realizar esta operación"}
# @no-cookie-jar
GET {{base}}/repuestos
Cookie: {{loginCliente.response.headers.Set-Cookie}}

### 11. GET /repuestos/1 con la sesion de un cliente
# El rol se exige antes de buscar el repuesto.
# Esperado: 403 {"detail": "No tiene permiso para realizar esta operación"} (NO 404)
# @no-cookie-jar
GET {{base}}/repuestos/1
Cookie: {{loginCliente.response.headers.Set-Cookie}}

### 12. POST /repuestos con la sesion de recepcion y cuerpo valido
# Esperado: 403 {"detail": "No tiene permiso para realizar esta operación"}
# psql: no existe el repuesto:
#   SELECT count(*) FROM repuesto WHERE codigo = 'R11-INTRUSO';  -- 0
# @no-cookie-jar
POST {{base}}/repuestos
Content-Type: application/json
Cookie: {{loginRecepcion.response.headers.Set-Cookie}}

{
  "codigo": "R11-INTRUSO",
  "descripcion": "Repuesto del intruso",
  "precio": 1000
}

### 13. POST /repuestos con la sesion de mecanico y cuerpo valido
# Esperado: 403 {"detail": "No tiene permiso para realizar esta operación"}
# psql: no existe el repuesto:
#   SELECT count(*) FROM repuesto WHERE codigo = 'R11-INTRUSO';  -- 0
# @no-cookie-jar
POST {{base}}/repuestos
Content-Type: application/json
Cookie: {{loginMecanico.response.headers.Set-Cookie}}

{
  "codigo": "R11-INTRUSO",
  "descripcion": "Repuesto del intruso",
  "precio": 1000
}

### 14. POST /repuestos sin cookie y con un campo extra
# La sesion se exige antes que el contrato del cuerpo.
# Esperado: 401 {"detail": "Se requiere iniciar sesión"} (NO 422)
# @no-cookie-jar
POST {{base}}/repuestos
Content-Type: application/json

{
  "codigo": "R11-INTRUSO",
  "descripcion": "Repuesto del intruso",
  "precio": 1000,
  "stock": 5
}

### 15. GET /repuestos con la sesion de recepcion (catalogo vacio)
# Esperado: 200 {"items": [], "total": 0, "page": 1, "size": 20, "pages": 1}
# @no-cookie-jar
GET {{base}}/repuestos
Cookie: {{loginRecepcion.response.headers.Set-Cookie}}

# =============================================================================
# C. Alta (specs parts-catalog y stock-movements)
# =============================================================================

### 16. Alta con codigo y descripcion a normalizar y stock inicial
# Esperado: 201 exactamente {"id": <n>, "codigo": "FIL-ACE-01", "descripcion": "Filtro de aceite",
#   "precio": "8500.00", "stock": 10}
# psql: un movimiento de stock inicial hecho por jefa, sin orden:
#   SELECT cantidad, motivo, orden_id, usuario_id = (SELECT id FROM usuario WHERE email = 'jefa@repuestos.example.com')
#     FROM movimiento_stock WHERE repuesto_id = (SELECT id FROM repuesto WHERE codigo = 'FIL-ACE-01');
#     -- 10 | Stock inicial | (NULL) | t
# @name altaFiltro
# @no-cookie-jar
POST {{base}}/repuestos
Content-Type: application/json
Cookie: {{loginJefa.response.headers.Set-Cookie}}

{
  "codigo": " fil-ace-01 ",
  "descripcion": "  Filtro de aceite ",
  "precio": 8500,
  "stock_inicial": 10
}

### 17. Alta con precio en texto y stock inicial 4
# Esperado: 201 {"id": <n>, "codigo": "PAS-FRE-DEL", "descripcion": "Pastillas de freno delanteras",
#   "precio": "32000.00", "stock": 4}
# @name altaPastillas
# @no-cookie-jar
POST {{base}}/repuestos
Content-Type: application/json
Cookie: {{loginJefa.response.headers.Set-Cookie}}

{
  "codigo": "PAS-FRE-DEL",
  "descripcion": "Pastillas de freno delanteras",
  "precio": "32000.00",
  "stock_inicial": 4
}

### 18. Alta sin stock_inicial y con precio de un decimal
# Esperado: 201 con "precio": "4500.50" y "stock": 0
# psql: sin movimientos de BUJ-01:
#   SELECT count(*) FROM movimiento_stock WHERE repuesto_id = (SELECT id FROM repuesto WHERE codigo = 'BUJ-01');  -- 0
# @name altaBujia
# @no-cookie-jar
POST {{base}}/repuestos
Content-Type: application/json
Cookie: {{loginJefa.response.headers.Set-Cookie}}

{
  "codigo": "BUJ-01",
  "descripcion": "Bujía",
  "precio": 4500.5
}

### 19. Alta con stock_inicial 0 explicito
# Esperado: 201 con "stock": 0 (sin movimiento: el CHECK cantidad <> 0 lo impide y SUM = 0 = stock)
# @name altaAceite
# @no-cookie-jar
POST {{base}}/repuestos
Content-Type: application/json
Cookie: {{loginJefa.response.headers.Set-Cookie}}

{
  "codigo": "ACE-5W30-1L",
  "descripcion": "Aceite 5W30 por litro",
  "precio": 12000,
  "stock_inicial": 0
}

### 20. Codigo repetido (normalizado a mayusculas)
# Esperado: 409 {"detail": "Ya existe un repuesto vigente con el código FIL-ACE-01"}
# psql: un solo FIL-ACE-01 y 2 movimientos en total (filtro y pastillas):
#   SELECT count(*) FROM repuesto WHERE codigo = 'FIL-ACE-01';  -- 1
#   SELECT count(*) FROM movimiento_stock;  -- 2
# @no-cookie-jar
POST {{base}}/repuestos
Content-Type: application/json
Cookie: {{loginJefa.response.headers.Set-Cookie}}

{
  "codigo": "fil-ace-01",
  "descripcion": "Otro filtro",
  "precio": 1000,
  "stock_inicial": 3
}

### 21. Campo reservado stock en el cuerpo (RN14)
# Esperado: 422 con loc ["body", "stock"] y type "extra_forbidden"
# psql: no se creo:
#   SELECT count(*) FROM repuesto WHERE codigo = 'R11-STOCK';  -- 0
