# =============================================================================
# test/transiciones.http -- Casos de C-14 ordenes-transiciones
#   (POST /ordenes/{id}/iniciar, POST /ordenes/{id}/terminar, POST /ordenes/{id}/cancelar --
#    las transiciones de estado de una orden de trabajo; terminar descuenta el stock por el
#    punto unico de escritura de stock (RN14) y agenda el aviso simulado al cliente)
#
# Cliente HTTP: extension REST Client de VS Code (o el cliente HTTP de JetBrains).
# Servidor: .venv\Scripts\python.exe -m uvicorn main:app --port 8000
# Las comprobaciones de filas se hacen con psql (consultas en cada caso). El aviso de las
# ordenes terminadas se ve en la consola de uvicorn (logger uvicorn.error.avisos).
#
# ESTADO CONOCIDO ANTES DE CORRER EL ARCHIVO DE ARRIBA ABAJO
#   (migrado a la ultima revision; sin seed -- C-06 -- la base queda sin repuestos, ordenes ni
#    catalogo de estados):
#
#   -- 1) vacia el dominio de ordenes y repuestos. El disparador de solo agregado rechaza DELETE en
#   --    historial_estado_orden, movimiento_stock e historial_precio_repuesto, y una orden creada por
#   --    la API no se puede borrar porque su historial la referencia; TRUNCATE no dispara el
#   --    disparador (es la via que usa seed.py para recargar el estado inicial). Sin CASCADE: falla
#   --    si otra tabla los referenciara.
#   --    ATENCION: vacia TODAS las ordenes y TODOS los repuestos, tambien los de otros datos de
#   --    desarrollo.
#   TRUNCATE historial_estado_orden, item_orden, movimiento_stock, historial_precio_repuesto,
#     orden_trabajo, repuesto RESTART IDENTITY;
#
#   -- 2) limpia SOLO lo de este archivo (correos @transiciones.example.com, documentos 470000xx,
#   --    patentes ZT...):
#   DELETE FROM vehiculo WHERE patente LIKE 'ZT%';
#   DELETE FROM evento_seguridad WHERE actor LIKE '%@transiciones.example.com'
#     OR accion LIKE '%@transiciones.example.com%';
#   DELETE FROM intento_acceso WHERE email LIKE '%@transiciones.example.com';
#   DELETE FROM asignacion_rol WHERE usuario_id IN
#     (SELECT id FROM usuario WHERE email LIKE '%@transiciones.example.com')
#     OR otorgada_por IN (SELECT id FROM usuario WHERE email LIKE '%@transiciones.example.com');
#   DELETE FROM vehiculo WHERE cliente_id IN (SELECT id FROM cliente WHERE documento LIKE '470000%');
#   DELETE FROM cliente WHERE documento LIKE '470000%' OR usuario_id IN
#     (SELECT id FROM usuario WHERE email LIKE '%@transiciones.example.com');
#   DELETE FROM usuario WHERE email LIKE '%@transiciones.example.com';
#
#   -- 3) catalogo de estados (C-06 todavia no existe; si ya esta cargado no cambia nada) y
#   --    es_final conocido (una corrida anterior cortada en el caso 49 lo dejaria alterado):
#   INSERT INTO estado_orden (codigo, descripcion, posicion, es_final) VALUES
#     ('PENDIENTE', 'Pendiente', 1, false), ('EN_REPARACION', 'En reparación', 2, false),
#     ('TERMINADA', 'Terminada', 3, true), ('CANCELADA', 'Cancelada', 4, true)
#   ON CONFLICT DO NOTHING;
#   UPDATE estado_orden SET es_final = (codigo IN ('TERMINADA', 'CANCELADA'));
#
# Si C-06 (seed) ya existe, correr `python seed.py` antes y luego el bloque de arriba.
# Rangos propios: correos @transiciones.example.com, documentos 470000xx (C-10 usa 430000xx, C-11
# 440000xx, C-12 450000xx, C-13 460000xx), patentes ZT... (C-10 usa ZC..., C-13 ZO...), codigos de
# repuesto TRN-... (C-12 usa STK-..., C-13 ORD-...; el script verificar_c14.py usa ZTS... y
# SCRIPT-C14-...).
# El archivo es de una sola pasada sobre ese estado: los ids de repuesto (1 a 5) y de orden (1 a 8)
# salen de RESTART IDENTITY.
#
# Reutilizar una sesion: `Cookie: {{loginMecanico.response.headers.Set-Cookie}}` (todas las
# peticiones llevan `# @no-cookie-jar`: nada se envia por el jar del cliente).
#
# Personas: jefa (ADMIN), recepcion (RECEPCION), mecanico y mecanico2 (MECANICO), duena (solo
# CLIENTE; duena de dos vehiculos), ajeno (solo CLIENTE, sin vehiculos), pendiente (debe cambiar
# la contrasena) y Jorge (ficha sin usuario, creada por recepcion). Todas las cuentas se crean por
# registro + INSERT del rol.
#
# Repuestos (ids de RESTART IDENTITY): 1 TRN-FIL-01 (stock 10), 2 TRN-FRE-01 (4), 3 TRN-BUJ-01 (2),
# 4 TRN-ACE-01 (20), 5 TRN-BAJA-01 (3; se da de baja en el caso 72).
# Ordenes (todas creadas PENDIENTES por recepcion, ids 1 a 8): 1 aceite y filtro (duena, vehiculo 1);
# 2 cuatro bujias con stock 2 (Jorge; caso PDF C-11/C-12); 3 y 4 para cancelar; 5 con el segundo
# repuesto sin stock (rollback total); 6 con el repuesto que se da de baja; 7 para el rol revocado;
# 8 para el catalogo y la cancelacion del ADMIN.
# =============================================================================

@base = http://localhost:8000


# =============================================================================
# A. Preparacion
# =============================================================================

### 1. Registro de jefa@transiciones.example.com
# Esperado: 201 con {id, email, nombre, cliente:{...}}
# @name registroJefa
# @no-cookie-jar
POST {{base}}/auth/registro
Content-Type: application/json

{
  "email": "jefa@transiciones.example.com",
  "password": "ClaveSegura1",
  "nombre": "Josefina Jefa",
  "documento": "47000001",
  "telefono": "1147000001"
}

