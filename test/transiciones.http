### 50. iniciar la orden 1 con loginMecanico: 200 con el detalle y la linea nueva
# Esperado: 200 exactamente {"id": 1, "estado": "EN_REPARACION", "patente": "ZTR001", "total": "56500.00",
#   "creada_en": "<ISO con Z>", "mecanico_id": <mecanico>, "falla": "Cambio de aceite y filtro",
#   "cliente": "Laura Duena", "items": [{"repuesto_id": 1, "codigo": "TRN-FIL-01",
#   "descripcion": "Filtro de aceite", "cantidad": 1, "precio_unitario": "8500.00", "subtotal": "8500.00"},
#   {"repuesto_id": 4, "codigo": "TRN-ACE-01", "descripcion": "Aceite 5W30 por litro", "cantidad": 4,
#   "precio_unitario": "12000.00", "subtotal": "48000.00"}],
#   "historial": [{"desde_estado": null, "hasta_estado": "PENDIENTE", "usuario_id": <recepcion>, ...},
#   {"desde_estado": "PENDIENTE", "hasta_estado": "EN_REPARACION", "usuario_id": <mecanico>,
#   "cuando": "<ISO con Z>"}]}
# psql: el mecanico quedo asignado y la linea de historial es suya; el stock no se mueve:
#   SELECT estado, mecanico_id = (SELECT id FROM usuario WHERE email = 'mecanico@transiciones.example.com') FROM orden_trabajo WHERE id = 1;  -- EN_REPARACION | t
#   SELECT desde_estado, hasta_estado, usuario_id = (SELECT id FROM usuario WHERE email = 'mecanico@transiciones.example.com') FROM historial_estado_orden WHERE orden_id = 1 ORDER BY id DESC LIMIT 1;  -- PENDIENTE | EN_REPARACION | t
#   SELECT id, stock FROM repuesto WHERE id IN (1, 4) ORDER BY id;  -- (1,10) (4,20)
# @name iniciarOrden1
# @no-cookie-jar
POST {{base}}/ordenes/1/iniciar
Cookie: {{loginMecanico.response.headers.Set-Cookie}}

